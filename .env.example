# HawkEye v2 Configuration
# Copy this file to .env and customize

# Application
APP_NAME=HawkEye
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Database
# SQLite (default) - zero-config development
DATABASE_URL=sqlite+aiosqlite:///./hawkeye.db

# PostgreSQL (production) - uncomment and configure for production
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hawkeye

# Database debugging
DATABASE_ECHO=false

# Connection pool (server databases only; SQLite keeps driver defaults).
# Serverless (Vercel + Supabase pooler): small values + statement cache off
# for pgbouncer transaction mode.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# DB_PREPARED_STATEMENT_CACHE_SIZE=0

# Supabase Realtime (production split deployment only).
# SUPABASE_JWT_SECRET must equal the Supabase project's JWT secret: it signs
# the short-lived realtime tokens minted by POST /api/v1/realtime-token.
# Never commit a value, never expose it under VITE_*. Unset locally.
# SUPABASE_JWT_SECRET=
# Short-lived token lifetime (seconds).
# REALTIME_TOKEN_TTL_SECONDS=3600

# Serverless runtime flags (set to 1 on Vercel; unset for local uvicorn).
# HAWKEYE_SKIP_CREATE_ALL=1
# HAWKEYE_DISABLE_HEARTBEAT=1

# Security
# Generate a secure 32+ character secret for production
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SECRET=change-this-in-production-min-32-characters
JWT_SECRET=change-this-in-production-min-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# API Key header name
API_KEY_HEADER=X-API-Key

# Detection Thresholds
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW_MINUTES=15
CRED_STUFFING_MAX_USERNAMES=10
CRED_STUFFING_WINDOW_MINUTES=10
ENUMERATION_404_THRESHOLD=20
ENUMERATION_WINDOW_MINUTES=5
SESSION_HIJACK_MAX_DISTANCE_KM=500
SESSION_HIJACK_WINDOW_HOURS=1
API_ABUSE_RPM_THRESHOLD=300
BOT_DETECTION_CONFIDENCE_THRESHOLD=0.7

# Correlation
CORRELATION_TIME_WINDOW_HOURS=24
CORRELATION_MIN_ALERTS=2
INCIDENT_AUTO_CLOSE_HOURS=72

# Frontend
FRONTEND_WS_HEARTBEAT_SECONDS=30
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]