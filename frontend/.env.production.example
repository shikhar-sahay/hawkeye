# Hawkeye frontend - production environment (Vercel)

# The frontend is a static SPA. It calls the backend REST API and WebSocket
# on the Render backend's public origin. Set these in Vercel:
#   Project Settings -> Environment Variables

# REST API base URL (no trailing slash).
# Example: https://hawkeye-api.onrender.com
VITE_API_BASE_URL=

# WebSocket base URL (wss:// in production).
# Example: wss://hawkeye-api.onrender.com
VITE_WS_URL=

# Both default to empty string (same origin) when not set, which matches
# local development where Vite proxies /api and /ws to localhost:8000.
# On Vercel + Render, both MUST be set to the Render backend origin.

# Do NOT put secrets, database URLs, or service credentials under VITE_*.
# Only public frontend configuration belongs here.
