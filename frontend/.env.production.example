# Hawkeye frontend - production environment (Vercel)
#
# The dashboard is a static SPA. By default it calls the API and WebSocket on
# the SAME origin (reverse-proxy setup). When the frontend is deployed
# separately (e.g. Vercel) from the backend (e.g. Render), point both at the
# backend's public HTTPS/WSS origin.
#
# Set these in Vercel: Project Settings -> Environment Variables.

# REST API base (no trailing slash). Empty = same origin.
# Example: https://hawkeye-backend.onrender.com
VITE_API_BASE_URL=

# WebSocket base for /ws (wss:// in production). Empty = same origin.
# Example: wss://hawkeye-backend.onrender.com
VITE_WS_URL=

# Supabase Realtime (production split deployment: Vercel + Supabase).
# When BOTH are set, the dashboard uses Supabase Realtime (postgres_changes
# scoped to the signed-in source by RLS) instead of the raw backend WebSocket.
# The anon key is public by design; RLS denies everything except
# source-scoped subscription reads. Service-role key and JWT secret stay
# server-side (Vercel function env) and MUST NEVER appear here.
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=

# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=
