{
  "name": "hawkeye-browser-agent",
  "version": "0.1.0",
  "description": "HawkEye Browser Security Agent - Chrome MV3 Extension",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "vite build --mode production",
    "build:watch": "vite build --mode development --watch",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && web-ext build --source-dir=dist --artifacts-dir=web-ext-artifacts",
    "sign": "web-ext sign --source-dir=dist --artifacts-dir=web-ext-artifacts --api-key=$WEB_EXT_API_KEY --api-secret=$WEB_EXT_API_SECRET"
  },
  "dependencies": {
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-static-copy": "^1.0.1",
    "web-ext": "^7.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}